CERTIKART_ENVIRONMENT=development
CERTIKART_LOG_LEVEL=INFO
CERTIKART_DATABASE_URL=postgresql+psycopg://certikart:certikart_dev_only@localhost:5432/certikart
# Production example: use the database URL from Supabase Connect and a rotated password.
# CERTIKART_DATABASE_URL=postgresql+psycopg://postgres:ROTATED_PASSWORD@db.strdsunuvbqbgwjfapzm.supabase.co:5432/postgres?sslmode=require
# Local/test can bootstrap metadata. Production must use migrations.
CERTIKART_SCHEMA_MANAGEMENT=bootstrap
CERTIKART_REQUEST_TIMEOUT_SECONDS=30
CERTIKART_MAX_SOURCE_CONCURRENCY=2
CERTIKART_OBEY_ROBOTS_TXT=true
CERTIKART_COLLECTION_PROFILE=smoke

# Product semantic documents and embeddings use the same PostgreSQL catalog.
# Keep generation/search disabled until a provider and model are configured.
CERTIKART_EMBEDDING_GENERATION_ENABLED=false
# API shape: openai -> POST /embeddings, ollama -> POST /api/embed.
CERTIKART_EMBEDDING_API_FORMAT=openai
CERTIKART_EMBEDDING_PROVIDER=
CERTIKART_EMBEDDING_MODEL=
# OpenAI-compatible POST /embeddings endpoint. OpenAI requires an API key;
# compatible local endpoints may leave the key empty.
CERTIKART_EMBEDDING_API_KEY=
CERTIKART_EMBEDDING_BASE_URL=https://api.openai.com/v1
CERTIKART_EMBEDDING_DIMENSIONS=1536
CERTIKART_EMBEDDING_BATCH_SIZE=32
CERTIKART_EMBEDDING_TIMEOUT_SECONDS=30
CERTIKART_SEMANTIC_SEARCH_ENABLED=false

# Optional pipeline-side embedding generation. The pipeline does not need OpenRouter
# for scraping, parsing, matching, persistence, or the advisor's query embeddings.
# Set these only when running the pipeline's embedding-backfill command. The key may
# come from the same OpenRouter account, but keep it in the pipeline's own secret store.
# CERTIKART_EMBEDDING_GENERATION_ENABLED=true
# CERTIKART_EMBEDDING_API_FORMAT=openai
# CERTIKART_EMBEDDING_PROVIDER=openrouter
# CERTIKART_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# CERTIKART_EMBEDDING_API_KEY=replace-with-openrouter-key
# CERTIKART_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# CERTIKART_EMBEDDING_DIMENSIONS=4096

# Development PostgreSQL container only. Never reuse this password outside local development.
POSTGRES_DB=certikart
POSTGRES_USER=certikart
POSTGRES_PASSWORD=certikart_dev_only
POSTGRES_PORT=5432
DB_UI_PORT=8081

# Production deployment input; use an immutable registry tag or image digest.
CERTIKART_PIPELINE_IMAGE=ghcr.io/your-org/certikart-pipeline:replace-me

# Product images: enable after configuring an existing S3 bucket.
CERTIKART_IMAGE_UPLOAD_ENABLED=false
# Compact Supabase Storage setup (recommended for Certikart):
CERTIKART_IMAGE_BUCKET=
CERTIKART_IMAGE_SUPABASE_URL=
CERTIKART_IMAGE_SUPABASE_SECRET_KEY=

# Optional AWS/S3-compatible setup. Leave blank when using Supabase above.
CERTIKART_IMAGE_S3_BUCKET=
CERTIKART_IMAGE_S3_REGION=ap-northeast-2
# S3-compatible services such as Supabase Storage require their custom endpoint
# and path-style addressing. Leave both defaults for AWS S3.
CERTIKART_IMAGE_S3_ENDPOINT_URL=https://strdsunuvbqbgwjfapzm.storage.supabase.co/storage/v1/s3
CERTIKART_IMAGE_S3_FORCE_PATH_STYLE=true
# Optional override. Leave empty to generate direct S3 URLs from bucket + region.
CERTIKART_IMAGE_PUBLIC_BASE_URL=
CERTIKART_IMAGE_S3_PREFIX=products
CERTIKART_IMAGE_MAX_BYTES=8000000
CERTIKART_IMAGE_MAX_DIMENSION=1200
CERTIKART_IMAGE_MAX_PER_PRODUCT=4
# Prefer an IAM role/AWS profile. Optional local credentials (never commit real values):
CERTIKART_IMAGE_S3_ACCESS_KEY_ID=
CERTIKART_IMAGE_S3_SECRET_ACCESS_KEY=
CERTIKART_IMAGE_S3_SESSION_TOKEN=
